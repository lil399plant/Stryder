# Shared storage (optional). Without these, Stryder works fine using only
# localStorage on each device — it just won't be shared between caregivers.
#
# To link it:
#   1. Create a free project at https://supabase.com (or use an existing one).
#   2. In the SQL Editor, run:
#        create table if not exists app_data (
#          id text primary key,
#          data jsonb not null,
#          updated_at timestamptz not null default now()
#        );
#   3. Project Settings -> API. Copy the "Project URL" and the
#      "service_role" secret key (NOT the anon/public key — the service
#      role key is server-only and must never be exposed to the browser;
#      this app only ever uses it inside a server-side API route).
#
# For local development, copy this file to .env.local and fill these in.
# On Vercel, add them under Project -> Settings -> Environment Variables.
#
# The same two vars also power Health > Vaccines / vet document uploads
# (Supabase Storage) — no separate setup needed there. That bucket
# ("health-documents") is created automatically, public, the first time
# someone uploads a file — see lib/supabase.ts.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI Triage (optional). A standalone "ask anything" chat module, disconnected
# from the rest of the app's data — without this key the /triage page just
# shows a "not set up yet" message.
#
#   1. Get an API key from https://platform.deepseek.com (API keys section).
#   2. Paste it below (local dev) or add it under Vercel -> Project ->
#      Settings -> Environment Variables (production).
#
# DEEPSEEK_MODEL is optional and defaults to "deepseek-chat".

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
