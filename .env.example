# Shared storage (optional). Without these, Stryder works fine using only
# localStorage on each device — it just won't be shared between caregivers.
#
# To link it:
#   1. Vercel dashboard -> your project -> Storage -> Create Database -> Redis
#      (Upstash). Vercel injects these automatically into your project's env
#      vars — you don't need to copy/paste anything.
#   OR
#   2. Create a free database at https://console.upstash.com, open its
#      "REST API" tab, and copy the two values below.
#
# For local development, copy this file to .env.local and fill these in.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
